# OS-practical
# Simple Operating System Simulator
processes = []
while True:
    print("1. Create Process")
    print("2. Show Processes")
    print("3. Run CPU")
    print("4. Exit")
    choice = input("Enter choice: ")
    if choice == "1":
        name = input("Process name: ")
        time = int(input("CPU time: "))
        processes.append([name, time])
        print("Process created!")
    elif choice == "2":
        print("Processes:")
        for p in processes:
            print(p[0], "- CPU Time:", p[1])
    elif choice == "3":
        print("CPU Scheduling:")
        for p in processes:
            print("Running", p[0], "for", p[1], "seconds")
        processes.clear()
        print("All processes completed.")
    elif choice == "4":
        print("Simulator closed.")
        break
    else:
        print("Invalid choice!")
